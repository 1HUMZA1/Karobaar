# Karobaar Application Environment Variables Template
# Copy this file to .env.local to configure your private credentials securely.
# DO NOT commit .env.local to version control.

# --- Firebase Configuration (Client-side) ---
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- Karobaar AI & Jarvis Model Configuration (Server-side ONLY) ---
# Set your replacement AI API key below. This key is processed strictly server-side
# by the Karobaar backend gateway and is never exposed in browser JavaScript, client bundles, or git.
AI_API_KEY=your_replacement_ai_api_key_here

# Supported Providers: 'gemini' (default), 'openai', 'groq', 'openrouter', 'custom'
AI_PROVIDER=gemini

# Model Name (e.g. 'gemini-1.5-flash', 'gemini-2.0-flash', 'gpt-4o-mini', 'llama-3.3-70b-versatile')
AI_MODEL=gemini-1.5-flash

# Optional: Specific Provider Keys (Alternative to AI_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: Custom AI Gateway URL (for enterprise proxies or self-hosted models)
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
