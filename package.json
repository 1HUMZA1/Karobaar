{
  "name": "e-business",
  "private": true,
  "homepage": "https://1HUMZA1.github.io/Karobaar",
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.karobaar.app",
    "productName": "Karobaar",
    "directories": {
      "output": "build-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder",
    "start:desktop": "electron .",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "release": "powershell ./release.ps1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "gh-pages": "^6.3.0",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
